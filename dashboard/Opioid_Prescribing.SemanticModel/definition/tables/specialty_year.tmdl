		annotation SummarizationSetBy = Automatic

	column opioid_claims
		dataType: double
		formatString: #,0.00
		lineageTag: 92edb2a5-af90-5d48-9e42-db99d932178d
		summarizeBy: sum
		sourceColumn: opioid_claims

		annotation SummarizationSetBy = Automatic

	column opioid_rate
		dataType: double
		formatString: #,0.00
		lineageTag: b99aa71d-82ab-5011-8330-e76c3dde7f8c
		summarizeBy: sum
		sourceColumn: opioid_rate

		annotation SummarizationSetBy = Automatic

	column share_of_all_opioid_claims
		dataType: double
		formatString: #,0.00
		lineageTag: 0a0e1b06-7f62-5207-b1a6-5f74221fb39a
		summarizeBy: sum
		sourceColumn: share_of_all_opioid_claims

		annotation SummarizationSetBy = Automatic

	column la_opioid_rate
		dataType: double
		formatString: #,0.00
		lineageTag: d288e205-18ed-507e-b404-92e91b0957d7
		summarizeBy: sum
		sourceColumn: la_opioid_rate

		annotation SummarizationSetBy = Automatic

	column avg_days_per_opioid_claim
		dataType: double
		formatString: #,0.00
		lineageTag: 2a6844e8-5d3b-53d8-b2e2-e844e06195eb
		summarizeBy: sum
		sourceColumn: avg_days_per_opioid_claim

		annotation SummarizationSetBy = Automatic

	partition specialty_year = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(PgServer, PgDatabase),
				    Data = Source{[Schema = "analytics", Item = "specialty_year"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table
