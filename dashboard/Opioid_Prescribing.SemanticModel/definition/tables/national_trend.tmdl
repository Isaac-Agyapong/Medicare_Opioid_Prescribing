	partition national_trend = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(PgServer, PgDatabase),
				    Data = Source{[Schema = "analytics", Item = "national_trend"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table

