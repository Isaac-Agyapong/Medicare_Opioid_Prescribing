table national_trend
	lineageTag: 26964520-c4a8-520a-8465-187b5066af2f

	measure 'Opioid Rate' = DIVIDE ( SUM ( national_trend[opioid_claims] ), SUM ( national_trend[total_claims] ) )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: National
		lineageTag: a3ca9591-9140-5144-b7ee-23715b83f541

	measure 'Opioid Claims' = SUM ( national_trend[opioid_claims] )
		formatString: #,0
		displayFolder: National
		lineageTag: bdd0aca2-52bd-5f5d-9b8d-4ce543447a9f

	measure 'Latest Opioid Rate' = CALCULATE ( [Opioid Rate], DimYear[Year] = MAX ( DimYear[Year] ) )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: National
		lineageTag: 40e78f17-610e-544b-9517-aa5ee6458d63

	measure 'Rate Change Since 2013' =
			VAR _now = [Latest Opioid Rate]
			VAR _base = CALCULATE ( [Opioid Rate], DimYear[Year] = 2013 )
			RETURN DIVIDE ( _now - _base, _base )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: National
		lineageTag: 2b09a7f7-de65-5ef5-8c49-4e969c970be8

	measure 'Opioid Deaths' = SUM ( national_trend[opioid_deaths] )
		formatString: #,0
		displayFolder: National
		lineageTag: 37d3ab1a-b273-5b76-a0b3-b533933bda25

	measure 'Synthetic Opioid Deaths' = SUM ( national_trend[synthetic_opioid_deaths] )
		formatString: #,0
		displayFolder: National
		lineageTag: 83dc35d6-7088-5930-9c86-1adcc476e32c

	measure 'Rx Opioid Deaths' = SUM ( national_trend[rx_opioid_deaths] )
		formatString: #,0
		displayFolder: National
		lineageTag: 844af11a-97f9-502a-a716-ec860a31ebf3

	measure 'Heroin Deaths' = SUM ( national_trend[heroin_deaths] )
		formatString: #,0
		displayFolder: National
		lineageTag: 89f5cf12-de41-53e1-a83b-eb71c6fd8f5a

	measure 'Latest Opioid Deaths' = CALCULATE ( [Opioid Deaths], DimYear[Year] = MAX ( DimYear[Year] ) )
		formatString: #,0
		displayFolder: National
		lineageTag: e9b6a35f-aa68-5ce8-ac4e-f02a82fb300a

	measure 'Peak Opioid Deaths' = MAXX ( ALL ( DimYear[Year] ), [Opioid Deaths] )
		formatString: #,0
		displayFolder: National
		lineageTag: b0504d6e-43e6-588d-9919-7ec12ddd3678

	measure 'Synthetic Share' = DIVIDE ( [Synthetic Opioid Deaths], [Opioid Deaths] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: National
		lineageTag: 2a6aaec3-ce53-586d-a101-f2348c3ad709

	measure 'Latest Synthetic Share' = CALCULATE ( [Synthetic Share], DimYear[Year] = MAX ( DimYear[Year] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: National
		lineageTag: 97a8acbd-f0d7-550a-acad-66613d4f67a6

	measure 'Peak Year' = MAXX ( TOPN ( 1, ALL ( DimYear[Year] ), [Opioid Deaths], DESC ), DimYear[Year] )
		formatString: 0
		displayFolder: Context
		lineageTag: 7baffb84-19e3-56e2-86f6-c6835d45f32b

	measure 'KPI Rate Context' =
			"in " & MAX ( DimYear[Year] ) & "  ·  was "
			    & FORMAT ( CALCULATE ( [Opioid Rate], DimYear[Year] = 2013 ), "0.00%" ) & " in 2013"
		displayFolder: Context
		lineageTag: 0d05a091-b65d-56f9-ac91-7a8f2430d893

	measure 'KPI Change Context' = "vs. 2013  ·  lower every year"
		displayFolder: Context
		lineageTag: eb641f23-eabe-5e84-baa5-1fa8decbbe6b

	measure 'KPI Peak Context' = "in " & [Peak Year] & "  ·  " & FORMAT ( [Latest Opioid Deaths], "#,0" ) & " in " & MAX ( DimYear[Year] )
		displayFolder: Context
		lineageTag: 385b68bb-106b-5d4c-a883-dc11e3c33d02

	measure 'KPI Synthetic Context' =
			"in " & MAX ( DimYear[Year] ) & "  ·  "
			    & FORMAT ( CALCULATE ( [Synthetic Share], DimYear[Year] = 2015 ), "0%" ) & " in 2015"
		displayFolder: Context
		lineageTag: 4219b615-010c-5fd1-bf20-1989ad4fad7e

	measure 'Fentanyl-Involved Deaths' = [Synthetic Opioid Deaths]
		formatString: #,0
		displayFolder: National
		lineageTag: e76349da-585d-51eb-9215-a4fb6756b572

	measure 'Other Opioid Deaths' =
			// opioid deaths not involving synthetic opioids: stacks with the line above without double counting
			[Opioid Deaths] - [Synthetic Opioid Deaths]
		formatString: #,0
		displayFolder: National
		lineageTag: ad1070c8-6797-54f1-b0cd-92ee8d1e1af2

	measure 'Latest Fentanyl-Involved Deaths' = CALCULATE ( [Fentanyl-Involved Deaths], DimYear[Year] = MAX ( DimYear[Year] ) )
		formatString: #,0
		displayFolder: National
		lineageTag: 063d621b-2ed2-5d87-a412-1e10bbfa0296

	measure 'Latest Other Opioid Deaths' = CALCULATE ( [Other Opioid Deaths], DimYear[Year] = MAX ( DimYear[Year] ) )
		formatString: #,0
		displayFolder: National
		lineageTag: 57d33eb7-2d9e-53fc-9274-b02a120601b0

	measure 'KPI Deaths Context' =
			"down " & FORMAT ( 1 - DIVIDE ( [Latest Opioid Deaths], [Peak Opioid Deaths] ), "0%" )
			    & " from the " & [Peak Year] & " peak"
		displayFolder: Context
		lineageTag: 5d8b7aea-2792-5ed1-8d1c-2d10522e6af9

