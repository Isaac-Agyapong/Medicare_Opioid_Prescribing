table rural_urban_trend
	lineageTag: 75f9b2ce-91e1-574b-8f9f-c9cada27f5c7

	measure 'Rural Opioid Rate' = CALCULATE ( AVERAGE ( rural_urban_trend[opioid_rate] ), rural_urban_trend[area] = "Rural" ) / 100
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Rural
		lineageTag: c68b8373-8e07-5a9c-8ad3-67d2d33d8e50

	measure 'Urban Opioid Rate' = CALCULATE ( AVERAGE ( rural_urban_trend[opioid_rate] ), rural_urban_trend[area] = "Urban" ) / 100
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Rural
		lineageTag: 8cccf363-bb23-5f94-866a-356f84c6b142

