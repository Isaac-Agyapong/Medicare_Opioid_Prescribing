model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table national_trend
ref table state_year
ref table specialty_year
ref table rural_urban_trend
ref table outlier_summary
ref table DimYear
ref table StateGrid

ref cultureInfo en-US

