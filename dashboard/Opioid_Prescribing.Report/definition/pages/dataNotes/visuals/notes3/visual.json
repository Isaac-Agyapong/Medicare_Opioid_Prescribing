                "textRuns": [
                  {
                    "value": "Limitations",
                    "textStyle": {
                      "fontSize": "18pt",
                      "color": "#10302E",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Medicare Part D only: mostly adults 65+ and people with disabilities",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#10302E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  CMS suppresses prescriber opioid counts of 1-10; these are 2.2% of claims",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#10302E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  2024 CDC counts are provisional",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#10302E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  State comparisons describe states, not individual patients",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#10302E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  An outlier is a flag for review, not evidence of inappropriate prescribing",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#10302E"
                    }
                  }
                ]
              }
            ]
