                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Opioid rate = opioid claims / all Part D claims",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#10302E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Fentanyl-type (synthetic) opioids = ICD-10 T40.4",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#10302E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Prescription-type opioids = natural & semi-synthetic opioids (T40.2)",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#10302E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Death rates are per 100,000 residents",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#10302E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Peer outlier = at or above the 99th percentile and 3x the median of the same specialty, with 100+ total and 50+ opioid claims",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#10302E"
                    }
                  }
                ]
              }
